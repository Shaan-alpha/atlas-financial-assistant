# Required. Atlas refuses to start without these.
TELEGRAM_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=

# Market-data providers, tried in this order. Any subset works and a missing key
# is skipped, not an error. Without at least one, fundamentals fall back to
# yfinance, which Yahoo blocks from datacenter IPs -- fine locally, dead in prod.
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# Defaults, shown with their values on purpose: a blank value here is read as an
# empty string, not as the default. PORT= would crash at startup and
# DATABASE_URL= would hand SQLAlchemy an empty URL.
DATABASE_URL=sqlite:///atlas.db
LOG_LEVEL=INFO
PORT=8080

# This service's own public URL, e.g. https://atlas-financial-assistant.onrender.com
# Deployment only: it turns on the 10-minute self-ping that stops a free host
# sleeping and making the next user wait ~50s. Leave blank locally.
PUBLIC_URL=
